---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Sportinkaart — Vind Jouw Sportlocatie in Nederland';
const description = 'Vind direct alle sportlocaties bij jou in de buurt. Van voetbalveldjes tot sportscholen — alles op één overzichtelijke kaart.';
---
<BaseLayout title={title} description={description} canonicalPath="/">
  <div id="hero-bg"></div>

  <header class="hero">
    <div class="hero-content">
      <h1>Sporten in<br><span>Nederland</span></h1>
      <p>Vind direct alle sportlocaties bij jou in de buurt. Van voetbalveldjes tot sportscholen, alles in één overzichtelijke kaart.</p>

      <div class="cta-buttons">
        <a href="#" class="btn btn-primary">
          <i class="fab fa-apple"></i> Download App
        </a>
        <a href="#" class="btn btn-outline">
          <i class="fab fa-google-play"></i> Play Store
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <img src="/logowittransparant.png" alt="Sportinkaart Icon" class="hero-logo-large">
    </div>
  </header>

  <section id="features" class="features">
    <h2 class="section-title">Waarom Sportinkaart?</h2>

    <div class="features-grid">
      <div class="feature-card">
        <div class="icon-box">
          <i class="fas fa-map-marker-alt"></i>
        </div>
        <h3>Locaties Dichtbij</h3>
        <p>Gebruik je GPS om direct te zien waar je kunt sporten in jouw directe omgeving.</p>
      </div>

      <div class="feature-card">
        <div class="icon-box">
          <i class="fas fa-running"></i>
        </div>
        <h3>Alle Sporten</h3>
        <p>Filter eenvoudig op jouw favoriete sport. Voetbal, tennis, fitness of hardlopen?</p>
      </div>

      <div class="feature-card">
        <div class="icon-box">
          <i class="fas fa-route"></i>
        </div>
        <h3>Direct Navigeren</h3>
        <p>Locatie gevonden? Start direct de routebeschrijving via Google Maps of Apple Maps.</p>
      </div>
    </div>
  </section>

  <section class="showcase">
    <div class="showcase-image">
      <div class="showcase-overlay">
        <img src="/logowittransparant.png" style="width: 100px; opacity: 0.8;" alt="Logo">
      </div>
    </div>
    <div class="showcase-text">
      <h2>Ontdek nieuwe <br><span class="highlight">Energie</span></h2>
      <p>Of je nu net verhuisd bent of gewoon een nieuwe plek zoekt om je energie kwijt te kunnen. Sportinkaart helpt je de weg te vinden.</p>
      <br>
      <p>Sluit je aan bij duizenden andere sporters in Nederland.</p>
    </div>
  </section>

  <section id="download" class="bottom-cta">
    <h2 class="section-title" style="margin-bottom: 40px;">Download de App</h2>
    <div class="cta-buttons" style="justify-content: center;">
      <a href="#" class="btn btn-primary">
        <i class="fab fa-apple"></i> Download App
      </a>
      <a href="#" class="btn btn-outline">
        <i class="fab fa-google-play"></i> Play Store
      </a>
    </div>
  </section>

  <section style="background:var(--dark-bg);color:#fff;padding:60px 5%;text-align:center;">
    <h2 style="font-weight:900;text-transform:uppercase;margin-bottom:24px;">Sporten in jouw stad</h2>
    <p><a href="/sporten-in-utrecht" style="color:var(--primary-teal);font-weight:700;">Bekijk alle steden &rarr;</a></p>
  </section>
</BaseLayout>

<style is:global>
  @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css');

  /* --- Hero Section --- */
  .hero {
    height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 5%;
    color: var(--text-light);
    position: relative;
    background: transparent;
    z-index: 2;
  }

  #hero-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: -1;
    background-color: var(--dark-bg);
    background-image: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/sportinkaart-banner.jpg');
    background-size: cover;
    background-position: center;
    will-change: transform;
  }

  .hero-content {
    flex: 1;
    max-width: 600px;
    animation: fadeIn 1s ease-out;
  }

  .hero h1 {
    font-size: 3.5rem;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 20px;
  }

  .hero h1 span {
    color: var(--primary-teal);
  }

  .hero p {
    font-size: 1.2rem;
    margin-bottom: 40px;
    opacity: 0.9;
  }

  .cta-buttons {
    display: flex;
    gap: 20px;
  }

  .btn {
    padding: 15px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-primary {
    background-color: var(--primary-teal);
    color: var(--dark-bg);
  }

  .btn-outline {
    border: 2px solid var(--text-light);
    color: var(--text-light);
  }

  .btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0, 230, 184, 0.3);
  }

  /* Hero Image/Phone Mockup area */
  .hero-visual {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-logo-large {
    width: 300px;
    filter: drop-shadow(0 0 20px rgba(0,230,184,0.4));
    animation: float 6s ease-in-out infinite;
  }

  /* --- Features Section --- */
  .features {
    padding: 80px 5%;
    background-color: transparent;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .section-title {
    font-size: 2.5rem;
    margin-bottom: 60px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--text-light);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
  }

  .feature-card {
    padding: 30px;
    background: var(--grey-light);
    border-radius: 20px;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .feature-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Staggered delays for the fade-in */
  .feature-card:nth-child(2) { transition-delay: 0.2s; }
  .feature-card:nth-child(3) { transition-delay: 0.4s; }

  .feature-card.visible:hover {
    transform: translateY(-10px);
    transition: transform 0.3s; /* Reset transition for hover */
  }

  .icon-box {
    width: 80px;
    height: 80px;
    background-color: var(--dark-bg);
    color: var(--primary-teal);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 2rem;
    margin: 0 auto 20px;
  }

  .feature-card h3 {
    margin-bottom: 15px;
    font-weight: 700;
  }

  /* --- App Showcase / Map Section --- */
  .showcase {
    display: flex;
    flex-wrap: wrap;
    background-color: var(--dark-bg);
    color: var(--text-light);
    position: relative;
    z-index: 2;
  }

  .showcase-text {
    flex: 1;
    padding: 80px 5%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 300px;
  }

  .showcase-text h2 {
    font-size: 2.5rem;
    margin-bottom: 20px;
  }

  .showcase-text .highlight {
    color: var(--primary-teal);
  }

  .showcase-image {
    flex: 1;
    background-color: #222;
    min-height: 400px;
    min-width: 300px;
    display: flex;
    justify-content: center;
    align-items: center;
    /* Placeholder for a map screenshot */
    background-image: url('https://maps.googleapis.com/maps/api/staticmap?center=Netherlands&zoom=7&size=600x600&style=feature:all|element:all|saturation:-100|visibility:simplified&key=YOUR_API_KEY');
    background-size: cover;
    position: relative;
  }

  .showcase-overlay {
    position: absolute;
    background: rgba(0,0,0,0.5);
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* --- Bottom CTA --- */
  .bottom-cta {
    padding: 80px 5%;
    text-align: center;
    background-color: var(--dark-bg);
    position: relative;
    z-index: 2;
  }

  /* --- Animations --- */
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
    100% { transform: translateY(0px); }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .hero {
      flex-direction: column-reverse;
      text-align: center;
      height: auto;
      padding: 100px 5% 50px;
    }

    .hero-content {
      margin-top: 40px;
    }

    .cta-buttons {
      justify-content: center;
      flex-direction: column;
    }

    .hero h1 {
      font-size: 2.5rem;
    }
  }
</style>

<script>
  const heroBg = document.getElementById('hero-bg');

  window.addEventListener('scroll', () => {
    const scrollPosition = window.scrollY;
    // Zoom effect: scale starts at 1 and increases slightly as you scroll
    const scale = 1 + scrollPosition * 0.0005;
    if (heroBg) {
      heroBg.style.transform = `scale(${scale})`;
    }
  });

  // Fade-in animation for feature cards
  const observerOptions = {
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.feature-card').forEach(card => {
    observer.observe(card);
  });
</script>
