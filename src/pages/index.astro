---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllCities } from '../lib/cityData';
import { groupCitiesByRegion } from '../lib/regions';
import { formatNl, joinNl, summariseCities } from '../lib/siteStats';

// Every number on this page is derived from the same build-time data as the city
// pages, so the copy can never drift from what the database actually contains.
const cities = await getAllCities();
const stats = summariseCities(cities);
const regions = groupCitiesByRegion(cities).map((group) => ({
  ...group,
  locationCount: group.cities.reduce((sum, c) => sum + c.locationCount, 0),
}));
const topSports = stats.sports.slice(0, 12);
const topSportNames = joinNl(topSports.slice(0, 5).map((s) => s.sport));
const regionNames = joinNl(regions.map((r) => r.inlineName));
const totalText = formatNl(stats.totalLocations);

const title = `Sportinkaart — ${totalText} sportlocaties in ${stats.cityCount} steden op de kaart`;
const description = `Vind sportlocaties bij jou in de buurt. ${totalText} sportscholen, clubs, zwembaden en velden in ${stats.cityCount} steden, verdeeld over ${stats.categoryCount} sportcategorieën.`;

const siteUrl = Astro.site!.href.replace(/\/$/, '');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'Sportinkaart',
    url: `${siteUrl}/`,
    logo: `${siteUrl}/icon-512.png`,
    image: `${siteUrl}/og-image.jpg`,
    description: `Sportinkaart brengt ${totalText} sportlocaties in ${stats.cityCount} Nederlandse steden samen op één kaart.`,
    sameAs: [
      'https://www.facebook.com/Sportinkaart/',
      'https://www.linkedin.com/company/67952688',
      'https://www.instagram.com/sportinkaart/',
    ],
    areaServed: cities.map((c) => ({
      '@type': 'City',
      name: c.name,
      url: `${siteUrl}/sporten-in-${c.slug}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    name: 'Sportinkaart',
    url: `${siteUrl}/`,
    inLanguage: 'nl-NL',
    description,
    publisher: { '@id': `${siteUrl}/#organization` },
  },
];
---
<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <div id="hero-bg"></div>

  <header class="hero">
    <div class="hero-content">
      <h1>Sporten in <span class="h1-accent">Nederland</span></h1>
      <p>
        Sportinkaart zet <strong>{totalText} sportlocaties</strong> in <strong>{stats.cityCount} steden</strong>
        op één kaart. Van sportschool en yogastudio tot voetbalveld, zwembad en jeu-de-boulesbaan —
        je ziet in één oogopslag waar je terechtkunt.
      </p>

      <div class="cta-buttons">
        <span class="btn btn-primary btn-soon" aria-disabled="true">
          <svg class="btn-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
          App Store — binnenkort
        </span>
        <span class="btn btn-outline btn-soon" aria-disabled="true">
          <svg class="btn-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M3.6 1.3 13.1 11 3.6 20.7c-.3-.2-.5-.6-.5-1.1V2.4c0-.5.2-.9.5-1.1zM14.5 12.4l2.6 2.6-10.6 6c-.3.2-.6.2-.9.1l8.9-8.7zM14.5 9.6 5.6 1c.3-.1.6-.1.9.1l10.6 6-2.6 2.5zM18.4 8.1l2.4 1.4c.8.5.8 1.6 0 2.1l-2.4 1.4L15.6 11l2.8-2.9z"/></svg>
          Play Store — binnenkort
        </span>
      </div>
    </div>

    <div class="hero-visual">
      <img
        src="/logowittransparant.png"
        alt="Het witte Sportinkaart-logo: een kaartspeld in de vorm van een sportveld"
        class="hero-logo-large"
        width="300"
        height="300"
      />
    </div>
  </header>

  <section id="features" class="features">
    <h2 class="section-title">Waarom Sportinkaart?</h2>

    <div class="features-grid">
      <div class="feature-card">
        <div class="icon-box">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21.5s7-6.4 7-11.4a7 7 0 1 0-14 0c0 5 7 11.4 7 11.4z"/><circle cx="12" cy="10" r="2.6"/></svg>
        </div>
        <h3>Locaties Dichtbij</h3>
        <p>Gebruik je GPS om direct te zien waar je kunt sporten in jouw directe omgeving.</p>
      </div>

      <div class="feature-card">
        <div class="icon-box">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor" aria-hidden="true" focusable="false"><rect x="1.5" y="9" width="3" height="6" rx="1.2"/><rect x="5" y="6.5" width="3.2" height="11" rx="1.4"/><rect x="15.8" y="6.5" width="3.2" height="11" rx="1.4"/><rect x="19.5" y="9" width="3" height="6" rx="1.2"/><rect x="8" y="10.6" width="8" height="2.8" rx=".6"/></svg>
        </div>
        <h3>Alle Sporten</h3>
        <p>Filter op jouw sport. {topSportNames} — en nog {stats.categoryCount - 5} andere categorieën.</p>
      </div>

      <div class="feature-card">
        <div class="icon-box">
          <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 3 3 10.4l7.6 3L13.6 21 21 3z"/></svg>
        </div>
        <h3>Direct Navigeren</h3>
        <p>Locatie gevonden? Start direct de routebeschrijving via Google Maps of Apple Maps.</p>
      </div>
    </div>
  </section>

  <section class="prose-section">
    <div class="prose">
      <h2 class="section-title section-title--dark">Wat staat er op de kaart?</h2>
      <p>
        Sportinkaart is een kaart van échte sportplekken, geen advertentiepagina. In de database staan op dit
        moment <strong>{totalText} actieve sportlocaties</strong>, verdeeld over <strong>{stats.categoryCount} sportcategorieën</strong>.
        Dat zijn commerciële sportscholen en yogastudio's, maar net zo goed verenigingen, gemeentelijke
        sporthallen, zwembaden, atletiekbanen, tennisparken en de jeu-de-boulesbaan om de hoek. Elke locatie
        heeft een adres en de sporten die er beoefend worden, zodat je niet eerst drie websites hoeft door te
        spitten voordat je weet of je er terechtkunt.
      </p>
      <p>
        De grootste categorie is met afstand <strong>{topSports[0].sport}</strong> ({formatNl(topSports[0].count)} locaties),
        gevolgd door {joinNl(topSports.slice(1, 4).map((s) => `${s.sport} (${formatNl(s.count)})`))}.
        Daarnaast zitten er veel kleinere categorieën in die je op een gewone zoekmachine
        nauwelijks gebundeld vindt — denk aan korfbal, klimmen, roeien, schaatsen of waterpolo.
        Juist die lange staart maakt het verschil als je iets specifieks zoekt.
      </p>

      <h3>Populairste sporten</h3>
      <ul class="sport-chips">
        {topSports.map((s) => (
          <li>{s.sport} <span class="chip-count">{formatNl(s.count)}</span></li>
        ))}
      </ul>

      <h2 class="section-title section-title--dark">Waar is Sportinkaart nu actief?</h2>
      <p>
        Sportinkaart is opgebouwd per stad in plaats van in één keer landelijk, zodat elke stad die erin zit
        ook echt compleet is. Op dit moment beslaat de kaart <strong>{stats.cityCount} steden</strong> in
        {' '}{regionNames}. De grootste is {stats.largestCity?.name} met {formatNl(stats.largestCity?.locationCount ?? 0)} locaties;
        ook kleinere plaatsen als Urk en Emmeloord zijn volledig in kaart gebracht. De rest van Nederland
        volgt stap voor stap — stad voor stad, met dezelfde controle op adres en sportaanbod.
      </p>

      <div class="region-grid">
        {regions.map((region) => (
          <div class="region-card">
            <h3>{region.name} <span class="region-count">{formatNl(region.locationCount)} locaties</span></h3>
            <p class="region-blurb">{region.blurb}</p>
            <ul class="region-cities">
              {region.cities.map((c) => (
                <li><a href={`/sporten-in-${c.slug}`}>{c.name} <span>{formatNl(c.locationCount)}</span></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <h2 class="section-title section-title--dark">Hoe werkt het?</h2>
      <ol class="steps">
        <li>
          <strong>Kies je stad of gebruik je locatie.</strong> Je begint bij een stadspagina of laat de kaart
          zien wat er binnen een paar kilometer van je afstand ligt.
        </li>
        <li>
          <strong>Filter op sport.</strong> Zoek je specifiek een zwembad, een boksschool of een plek om te
          padellen? Dan houd je alleen de locaties over die dat daadwerkelijk aanbieden.
        </li>
        <li>
          <strong>Navigeer erheen.</strong> Vanaf de locatie open je direct de route in Google Maps of Apple
          Maps, of je klikt door naar de website van de club of sportschool.
        </li>
      </ol>

      <h2 class="section-title section-title--dark">Voor wie is het bedoeld?</h2>
      <p>
        Voor iedereen die net verhuisd is en opnieuw moet uitvinden waar je in de buurt kunt sporten. Voor
        ouders die een club zoeken voor hun kind en willen weten welke verenigingen er eigenlijk zijn. Voor
        wie een keer iets anders wil proberen dan de sportschool waar je al drie jaar zit. En voor de sporter
        die op reis of tijdelijk elders werkt en gewoon een baan, een hal of een fitnessruimte zoekt.
        Sportinkaart is gratis te gebruiken en werkt zonder account.
      </p>
      <p class="prose-cta">
        <a href="/steden">Bekijk alle {stats.cityCount} steden op Sportinkaart &rarr;</a>
      </p>
    </div>
  </section>

  <section class="showcase">
    <div class="showcase-image">
      <div class="showcase-overlay">
        <img src="/logowittransparant.png" style="width: 100px; opacity: 0.8;" alt="" width="100" height="100" />
      </div>
    </div>
    <div class="showcase-text">
      <h2>Ontdek nieuwe <span class="highlight">Energie</span></h2>
      <p>
        Of je nu net verhuisd bent of gewoon een nieuwe plek zoekt om je energie kwijt te kunnen —
        Sportinkaart helpt je de weg te vinden.
      </p>
      <p>
        Geen eindeloos scrollen door zoekresultaten en verouderde clubwebsites, maar één kaart waarop je
        ziet wat er werkelijk in de buurt is.
      </p>
    </div>
  </section>

  <section id="download" class="bottom-cta">
    <h2 class="section-title" style="margin-bottom: 40px;">Download de App</h2>
    <div class="cta-buttons" style="justify-content: center;">
      <span class="btn btn-primary btn-soon" aria-disabled="true">
        <svg class="btn-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
        App Store — binnenkort
      </span>
      <span class="btn btn-outline btn-soon" aria-disabled="true">
        <svg class="btn-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M3.6 1.3 13.1 11 3.6 20.7c-.3-.2-.5-.6-.5-1.1V2.4c0-.5.2-.9.5-1.1zM14.5 12.4l2.6 2.6-10.6 6c-.3.2-.6.2-.9.1l8.9-8.7zM14.5 9.6 5.6 1c.3-.1.6-.1.9.1l10.6 6-2.6 2.5zM18.4 8.1l2.4 1.4c.8.5.8 1.6 0 2.1l-2.4 1.4L15.6 11l2.8-2.9z"/></svg>
        Play Store — binnenkort
      </span>
    </div>
    <p style="color: var(--text-light); opacity: 0.7; margin-top: 20px; font-size: 0.95rem;">De app komt binnenkort beschikbaar in de App Store en Google Play.</p>
  </section>

  <section class="city-cta">
    <h2 class="section-title" style="margin-bottom:24px;">Sporten in jouw stad</h2>
    <p><a href="/steden">Bekijk alle {stats.cityCount} steden &rarr;</a></p>
  </section>
</BaseLayout>

<style is:global>
  /* --- Hero Section --- */
  .hero {
    height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 5%;
    color: var(--text-light);
    position: relative;
    background: transparent;
    z-index: 2;
  }

  #hero-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: -1;
    background-color: var(--dark-bg);
    background-image: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/sportinkaart-banner.webp');
    background-size: cover;
    background-position: center;
    will-change: transform;
  }

  .hero-content {
    flex: 1;
    max-width: 600px;
    animation: fadeIn 1s ease-out;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 9vw, 3.5rem);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 20px;
    overflow-wrap: break-word;
  }

  /* Block display gives the second line its own row without a <br>, so the
     accessible name stays "Sporten in Nederland" with a real space. */
  .hero h1 .h1-accent {
    display: block;
    color: var(--primary-teal);
  }

  .hero p {
    font-size: 1.2rem;
    margin-bottom: 40px;
    opacity: 0.9;
  }

  .cta-buttons {
    display: flex;
    gap: 20px;
  }

  .btn {
    padding: 15px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-icon {
    flex-shrink: 0;
  }

  .btn-primary {
    background-color: var(--primary-teal);
    color: var(--dark-bg);
  }

  .btn-outline {
    border: 2px solid var(--text-light);
    color: var(--text-light);
  }

  .btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0, 230, 184, 0.3);
  }

  /* "Coming soon" state — non-clickable until the store listings go live */
  .btn-soon {
    cursor: default;
    opacity: 0.75;
  }

  .btn-soon:hover {
    transform: none;
    box-shadow: none;
  }

  /* Hero Image/Phone Mockup area */
  .hero-visual {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-logo-large {
    width: 300px;
    height: auto;
    filter: drop-shadow(0 0 20px rgba(0,230,184,0.4));
    animation: float 6s ease-in-out infinite;
  }

  /* --- Features Section --- */
  .features {
    padding: 80px 5%;
    background-color: transparent;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .section-title {
    /* Clamped so the uppercase 900-weight heading cannot overflow a 375px viewport. */
    font-size: clamp(1.6rem, 6.5vw, 2.5rem);
    margin-bottom: 60px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--text-light);
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .section-title--dark {
    color: var(--text-dark);
    margin-bottom: 24px;
    margin-top: 56px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
  }

  .feature-card {
    padding: 30px;
    background: var(--grey-light);
    border-radius: 20px;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .feature-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Staggered delays for the fade-in */
  .feature-card:nth-child(2) { transition-delay: 0.2s; }
  .feature-card:nth-child(3) { transition-delay: 0.4s; }

  .feature-card.visible:hover {
    transform: translateY(-10px);
    transition: transform 0.3s; /* Reset transition for hover */
  }

  .icon-box {
    width: 80px;
    height: 80px;
    background-color: var(--dark-bg);
    color: var(--primary-teal);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 20px;
  }

  .feature-card h3 {
    margin-bottom: 15px;
    font-weight: 700;
  }

  /* --- Editorial copy --- */
  .prose-section {
    background: #fff;
    padding: 40px 5% 80px;
    position: relative;
    z-index: 2;
  }

  .prose {
    max-width: 820px;
    margin: 0 auto;
  }

  .prose p {
    margin-bottom: 18px;
    font-size: 1.05rem;
  }

  .prose h3 {
    font-weight: 800;
    margin: 28px 0 14px;
  }

  .prose a {
    color: #00806a; /* teal, darkened for contrast on white */
    font-weight: 700;
  }

  .sport-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 12px;
  }

  .sport-chips li {
    background: var(--grey-light);
    border-radius: 50px;
    padding: 8px 16px;
    font-weight: 700;
  }

  .chip-count {
    color: #00806a;
  }

  .region-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin: 24px 0 8px;
  }

  .region-card {
    background: var(--grey-light);
    border-radius: 16px;
    padding: 20px;
  }

  .region-card h3 {
    margin: 0 0 6px;
    font-weight: 800;
  }

  .region-count {
    display: block;
    font-size: .85rem;
    font-weight: 700;
    color: #00806a;
  }

  .region-blurb {
    font-size: .95rem;
    opacity: .8;
    margin-bottom: 12px;
  }

  .region-cities {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
  }

  .region-cities a {
    font-weight: 700;
    text-decoration: underline;
  }

  .region-cities span {
    opacity: .6;
    font-weight: 400;
  }

  .steps {
    margin: 0 0 18px 1.1rem;
  }

  .steps li {
    margin-bottom: 12px;
  }

  .prose-cta {
    margin-top: 28px;
    font-size: 1.1rem;
  }

  /* --- App Showcase / Map Section --- */
  .showcase {
    display: flex;
    flex-wrap: wrap;
    background-color: var(--dark-bg);
    color: var(--text-light);
    position: relative;
    z-index: 2;
  }

  .showcase-text {
    flex: 1;
    padding: 80px 5%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 300px;
  }

  .showcase-text h2 {
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    margin-bottom: 20px;
    overflow-wrap: break-word;
  }

  .showcase-text .highlight {
    display: block;
    color: var(--primary-teal);
  }

  .showcase-text p + p {
    margin-top: 16px;
  }

  .showcase-image {
    flex: 1;
    background-color: #222;
    min-height: 400px;
    min-width: 300px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-size: cover;
    position: relative;
  }

  .showcase-overlay {
    position: absolute;
    background: rgba(0,0,0,0.5);
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* --- Bottom CTA --- */
  .bottom-cta {
    padding: 80px 5%;
    text-align: center;
    background-color: var(--dark-bg);
    position: relative;
    z-index: 2;
  }

  .city-cta {
    background: var(--dark-bg);
    color: #fff;
    padding: 60px 5%;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .city-cta a {
    color: var(--primary-teal);
    font-weight: 700;
  }

  /* --- Animations --- */
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
    100% { transform: translateY(0px); }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .hero {
      /* Content first (not column-reverse) so the H1 and both store CTAs sit
         above the fold instead of below a full-width logo. */
      flex-direction: column;
      text-align: center;
      height: auto;
      padding: 40px 5% 60px;
    }

    .hero-visual {
      margin-top: 32px;
    }

    .hero-logo-large {
      width: 180px;
    }

    .cta-buttons {
      justify-content: center;
      flex-direction: column;
    }

    .hero p {
      margin-bottom: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo-large { animation: none; }
    .hero-content { animation: none; }
    .feature-card { transition: none; }
  }
</style>

<script>
  const heroBg = document.getElementById('hero-bg');

  window.addEventListener('scroll', () => {
    const scrollPosition = window.scrollY;
    // Zoom effect: scale starts at 1 and increases slightly as you scroll
    const scale = 1 + scrollPosition * 0.0005;
    if (heroBg) {
      heroBg.style.transform = `scale(${scale})`;
    }
  });

  // Fade-in animation for feature cards
  const observerOptions = {
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.feature-card').forEach(card => {
    observer.observe(card);
  });
</script>
